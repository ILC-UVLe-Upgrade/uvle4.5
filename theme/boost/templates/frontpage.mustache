{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper" class="frontpage-wrapper">

    {{{ output.standard_top_of_body_html }}}

    {{> theme_boost/navbar }}

    <!-- Hero Section with Background Image -->
    <section class="hero-section">
        <div class="hero-background"></div>
        <div class="container">
            <div class="row align-items-center min-vh-75">
                <div class="col-lg-6">
                    <div class="hero-content">
                        <h1 class="hero-title display-4 fw-bold mb-4">
                            Welcome to UVLê
                        </h1>
                        <p class="hero-subtitle lead mb-4">
                            The University Virtual Learning Environment (UVLê​) is a learning management system. It allows UP teachers to design online learning spaces.
                        </p>
                        <div class="hero-buttons">
                            <a href="{{{ loginurl }}}" class="btn btn-primary btn-lg me-3 mb-2">
                                <i class="fa fa-sign-in me-2"></i>Login
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="hero-visual text-center">
                        <div class="hero-card">
                            <i class="fa fa-graduation-cap hero-icon"></i>
                            <h3 class="mt-3">Start Your Learning Journey</h3>
                            <p class="text-muted">Access courses, resources, and connect with your academic community.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Announcements Section -->
    {{# sitenews }}
    <section class="announcements-section py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="announcements-card">
                        <div class="announcements-header">
                            <h2 class="announcements-title">
                                <i class="fa fa-bullhorn me-3"></i>Latest Announcements
                            </h2>
                            <div class="announcements-divider"></div>
                        </div>
                        <div class="announcements-content">
                            {{{ sitenews }}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    {{/ sitenews }}

    {{> theme_boost/footer }}
</div>

<style>
/* Frontpage-specific styles that won't conflict with existing UVLE styles */
.frontpage-wrapper {
    background-color: #f8f9fa;
}

/* Hero Section */
.hero-section {
    position: relative;
    padding: 80px 0;
    overflow: hidden;
    background: linear-gradient(135deg, #7b1113 0%, #550708 100%);
    color: white;
    min-height: 100vh;
}

.hero-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url([[pix:theme|homepage_header_bg]]);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.15;
    z-index: 1;
}

.hero-section .container {
    position: relative;
    z-index: 2;
}

.hero-content {
    padding-right: 2rem;
    position: relative;
    z-index: 3;
}

.hero-title {
    color: white !important;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
    font-weight: 700;
    margin-bottom: 1.5rem;
}

.hero-subtitle {
    color: rgba(255,255,255,0.95) !important;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
    font-size: 1.2rem;
    line-height: 1.6;
    margin-bottom: 2rem;
}

.hero-buttons {
    position: relative;
    z-index: 3;
}

.hero-buttons .btn {
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    transition: all 0.3s ease;
    font-weight: 600;
    padding: 12px 24px;
    border-radius: 8px;
}

.hero-buttons .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.4);
}

.hero-visual {
    padding: 2rem;
    position: relative;
    z-index: 3;
}

.hero-card {
    background: rgba(255,255,255,0.15);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    padding: 3rem 2rem;
    border: 1px solid rgba(255,255,255,0.3);
    box-shadow: 0 8px 32px rgba(0,0,0,0.2);
}

.hero-card h3 {
    color: white !important;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
    font-weight: 600;
}

.hero-card p {
    color: rgba(255,255,255,0.9) !important;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
}

.hero-icon {
    font-size: 4rem;
    color: #f3aa2c;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
}

/* Announcements Section */
.announcements-section {
    background: white;
}

.announcements-card {
    background: white;
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    overflow: hidden;
    border: 1px solid #e9ecef;
}

.announcements-header {
    background: linear-gradient(135deg, #550708 0%, #7b1113 100%);
    color: white;
    padding: 2rem;
    text-align: center;
}

.announcements-title {
    margin: 0;
    font-weight: 600;
    font-size: 1.75rem;
}

.announcements-divider {
    width: 60px;
    height: 3px;
    background: #f3aa2c;
    margin: 1rem auto 0;
    border-radius: 2px;
}

.announcements-content {
    padding: 2rem;
    max-height: 400px;
    overflow-y: auto;
}

.announcements-content::-webkit-scrollbar {
    width: 8px;
}

.announcements-content::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 4px;
}

.announcements-content::-webkit-scrollbar-thumb {
    background: #014421;
    border-radius: 4px;
}

.announcements-content::-webkit-scrollbar-thumb:hover {
    background: #7b1113;
}

/* Features Section */
.features-section {
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
}

.features-title {
    color: #014421;
    font-weight: 700;
    margin-bottom: 1rem;
}

.features-subtitle {
    font-size: 1.1rem;
}

.feature-card {
    background: white;
    padding: 2.5rem 1.5rem;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    transition: all 0.3s ease;
    height: 100%;
    border: 1px solid #e9ecef;
}

.feature-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.15);
}

.feature-icon {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, #014421 0%, #7b1113 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    color: white;
    font-size: 2rem;
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
}

.feature-title {
    color: #014421;
    font-weight: 600;
    margin-bottom: 1rem;
}

.feature-description {
    color: #6c757d;
    line-height: 1.6;
}

/* Responsive Design */
@media (max-width: 768px) {
    .hero-section {
        padding: 60px 0;
    }
    
    .hero-content {
        padding-right: 0;
        text-align: center;
        margin-bottom: 2rem;
    }
    
    .hero-title {
        font-size: 2rem;
    }
    
    .hero-buttons .btn {
        display: block;
        width: 100%;
        margin-bottom: 1rem;
    }
    
    .hero-buttons .btn:last-child {
        margin-bottom: 0;
    }
    
    .announcements-header {
        padding: 1.5rem;
    }
    
    .announcements-content {
        padding: 1.5rem;
    }
    
    .feature-card {
        padding: 2rem 1rem;
        margin-bottom: 1rem;
    }
}

/* Minimum height for hero section */
.min-vh-75 {
    min-height: 75vh;
}

/* Ensure proper spacing */
.py-5 {
    padding-top: 3rem !important;
    padding-bottom: 3rem !important;
}

.mb-5 {
    margin-bottom: 3rem !important;
}

.g-4 {
    gap: 1.5rem !important;
}
</style>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
  M.util.js_complete('theme_boost/loader');
});
{{/js}}
